{
  "name": "flashcards-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:pdf-extraction": "node --test src/components/creator/pdf/pdfExtractionEngine.test.js",
    "test:schedule": "node --test src/components/library/calendar/scheduleUtils.test.js src/components/library/calendar/scheduleTimeline.test.js src/components/library/calendar/scheduleUiContracts.test.js src/components/library/calendar/attendanceUtils.test.js src/utils/pdf/schedule/schedulePdfLayout.test.js src/utils/pdf/schedule/schedulePdfRenderer.test.js src/utils/pdf/workerClient.test.js src/utils/pdf/download.test.js src/utils/pdf/index.test.js",
    "test:manual-editor:harness": "vite --config tests/manual-editor/vite.harness.config.js --host 127.0.0.1 --port 4174 --strictPort",
    "test:manual-editor:unit": "node --test src/components/creator/manual-editor/manualEditorSession.test.js src/components/creator/manual-editor/editorGeometry.test.js src/components/creator/manual-editor/editorLayerStack.test.js src/components/creator/manual-editor/editorActivation.test.js src/components/creator/manual-editor/colorUtils.test.js src/components/common/actionSheetGestureGuard.test.js src/components/common/actionSheetFocus.test.js src/components/common/overlays/overlayRegistry.test.js tests/manual-editor/manual-editor-contracts.test.js",
    "test:image-delivery": "node --test tests/image-delivery/image-delivery-contracts.test.js tests/image-delivery/cover-thumbnail.test.js",
    "test:library-browser": "node --test tests/performance/library-browser/library-browser-profile.test.js",
    "perf:library-browser": "node tests/performance/library-browser/run-browser-profile.mjs",
    "test:manual-editor": "playwright test tests/manual-editor/manual-editor-current.spec.js",
    "test:manual-editor:chromium": "playwright test tests/manual-editor/manual-editor-current.spec.js --project=chromium",
    "test:manual-editor:webkit": "playwright test tests/manual-editor/manual-editor-current.spec.js --project=webkit",
    "test:manual-editor:firefox": "playwright test tests/manual-editor/manual-editor-current.spec.js --project=firefox",
    "test:manual-editor:all": "npm run test:manual-editor:unit && npm run test:manual-editor",
    "qa:schedule-pdf": "node scripts/generateSchedulePdfSamples.mjs",
    "test:public-home": "node --test src/components/publicHomeContracts.test.js",
    "test:login:harness": "vite --config tests/public-home/vite.login.config.js --strictPort",
    "test:login": "playwright test --config=playwright.login.config.js",
    "test:login:chromium": "playwright test --config=playwright.login.config.js --project=chromium",
    "test:login:webkit": "playwright test --config=playwright.login.config.js --project=webkit",
    "test:playwright:smoke": "playwright test --config=playwright.smoke.config.js",
    "test:app:harness": "vite --config tests/app/vite.app.config.js",
    "test:app:smoke": "playwright test --config=playwright.app.config.js",
    "test:lua-video": "playwright test --config=playwright.lua-video.config.js",
    "test:app:chromium": "playwright test --config=playwright.app.config.js --project=chromium",
    "test:app:firefox": "playwright test --config=playwright.app.config.js --project=firefox",
    "test:app:webkit": "playwright test --config=playwright.app.config.js --project=webkit",
    "test:app:fullstack": "playwright test --config=playwright.fullstack.config.js",
    "setup:playwright:browsers": "playwright install chromium firefox webkit",
    "setup:playwright": "playwright install --with-deps chromium firefox webkit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@react-oauth/google": "^0.12.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "jspdf": "^2.5.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.439.0",
    "pdfjs-dist": "^4.4.168",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
